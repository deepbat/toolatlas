{
  "name": "toolatlas",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "One Place. Countless Useful Tools.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx scripts/static.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "test:expanded": "node scripts/expanded-tests.mjs",
    "prebuild": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs','public/pdfjs.worker.min.js')\"",
    "test:search": "tsx scripts/search-tests.ts",
    "test:unit": "tsx scripts/studio-unit-tests.ts && tsx scripts/upgrades-unit.ts && tsx scripts/device-unit.ts && tsx scripts/glyph-unit.ts",
    "test:device": "node scripts/device-tests.mjs",
    "test:studio": "node scripts/studio-tests.mjs",
    "test:quality": "node scripts/quality-checks.mjs && npm run test:upgrades",
    "test:a11y": "node scripts/a11y-tests.mjs",
    "test:pdf-editor": "node scripts/pdf-editor-tests.mjs",
    "test:av": "node scripts/av-tests.mjs",
    "test:directory": "node scripts/directory-tests.mjs",
    "test:demand": "node scripts/demand-tests.mjs",
    "test:upgrades": "node scripts/upgrades-tests.mjs",
    "test:icons": "node scripts/icon-tests.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.460.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.6"
  }
}