{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepaksTool",
  "version": "0.1.0",
  "identifier": "io.github.deepbat.toolatlas",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deepak's Tool",
        "width": 1280,
        "height": 840,
        "minWidth": 480,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": { "licenses/*": "licenses/" },
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
